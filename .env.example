# =============================================================================
# Diogenes — variables de entorno de EJEMPLO
# Copia este archivo a `.env` y rellénalo en local. `.env` NUNCA se sube a Git.
# Aquí solo hay placeholders: no pongas valores reales en este archivo.
# =============================================================================

# --- General ------------------------------------------------------------------
# Zona horaria de los contenedores (afecta a Calendar y a los logs).
TZ=Europe/Madrid

# --- Ollama (Fase 2) ----------------------------------------------------------
# Modelo que usa el agente. Para la comparativa de cuantización: qwen3.5:4b-q8_0
OLLAMA_MODEL=qwen3.5:4b
# URL de Ollama vista desde los otros contenedores (red interna "diogenes").
OLLAMA_BASE_URL=http://ollama:11434
# Puerto del host (solo 127.0.0.1) para probar Ollama desde Windows.
# No es 11434 para no chocar con un Ollama nativo instalado en el equipo.
OLLAMA_HOST_PORT=11435
# Ventana de contexto configurada (num_ctx). Se ajusta en la Fase 3.
OLLAMA_CONTEXT_LENGTH=8192
# Tiempo que el modelo se queda cargado en memoria tras una petición.
OLLAMA_KEEP_ALIVE=30m

# --- Telegram (Fase 4) --------------------------------------------------------
# Token que da @BotFather. Si se filtra: revocarlo en @BotFather con /revoke.
TELEGRAM_BOT_TOKEN=cambia-esto
# Chat IDs autorizados, separados por comas. El bot ignora al resto.
TELEGRAM_ALLOWED_CHAT_IDS=cambia-esto

# --- n8n (Fase 4) -------------------------------------------------------------
# Clave con la que n8n cifra las credenciales guardadas. Genérala una vez y no
# la cambies (si cambia, n8n no puede descifrar lo que ya tenía).
# PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
N8N_ENCRYPTION_KEY=cambia-esto

# --- Google OAuth (Fase 5) ----------------------------------------------------
# Rutas DENTRO del contenedor tools-mcp. Los archivos reales viven en ./secrets/
# del host (ignorado por Git) y se montan en /secrets.
# JSON del cliente OAuth descargado de Google Cloud (proyecto en modo prueba).
GOOGLE_OAUTH_CLIENT_FILE=/secrets/credentials.json
# Token generado tras autorizar la cuenta de prueba. En modo prueba caduca a los
# 7 días: renovarlo antes de la demo.
GOOGLE_OAUTH_TOKEN_FILE=/secrets/token.json

# --- tools-mcp (Fase 5) -------------------------------------------------------
# Secreto con el que tools-mcp firma los tokens de confirmación de un solo uso.
# Genéralo igual que N8N_ENCRYPTION_KEY, pero con un valor distinto.
CONFIRM_TOKEN_SECRET=cambia-esto
# Segundos de validez de un token de confirmación.
CONFIRM_TOKEN_TTL_SECONDS=300
# Base de datos de tareas (dentro del volumen de tools-mcp).
TAREAS_DB_PATH=/data/tareas.db
# URL de la API interna del simulador doméstico.
CASA_SIM_URL=http://casa-sim:8080

# --- casa-sim (Fase 5) --------------------------------------------------------
# Base de datos con el estado de la casa (dentro del volumen de casa-sim).
CASA_DB_PATH=/data/casa.db
